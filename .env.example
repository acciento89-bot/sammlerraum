DATABASE_URL=postgresql://sammlerraum:change-me@localhost:5432/sammlerraum
APP_ORIGIN=http://localhost:3000
# Local-process path. Docker Compose fixes the container path at /data/uploads.
UPLOADS_DIR=/var/lib/sammlerraum/uploads
LOG_LEVEL=info
WORKER_HEALTH_PORT=3001
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# Authentication. Generate BETTER_AUTH_SECRET with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google authorized redirect URI: ${APP_ORIGIN}/api/auth/callback/google
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# Apple Services ID return URL: ${APP_ORIGIN}/api/auth/callback/apple

# Required SMTP transport for email verification and password reset.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Media orphan retention and worker maintenance (hours / milliseconds / count).
MEDIA_RETENTION_HOURS=168
MEDIA_CLEANUP_INTERVAL_MS=60000
MEDIA_CLEANUP_BATCH_SIZE=100
STORAGE_TEMP_MAX_AGE_HOURS=24
# Upgrade precondition: stop all pre-cleanup web/worker writers before starting
# the upgraded worker against an existing shared uploads volume. All writers must
# use staging advisory locks; legacy .storage-UUID.tmp files have no live lock.

# Market adapters remain empty until separately authorized activation.
MARKET_SYNC_ENABLED=false
MARKET_SYNC_INTERVAL_MS=60000
MARKET_SYNC_BATCH_SIZE=32
MARKET_SYNC_MAX_PENDING=256

# Production market adapters stay OFF. Credentials alone do not enable ingestion.
# POLICY_APPROVED requires the documented rights/zero/currency/credit/routing/drain gates.
SCRYDEX_ENABLED=false
SCRYDEX_POLICY_APPROVED=false
SCRYDEX_HOURLY_CALL_BUDGET=0
SCRYDEX_DAILY_CALL_BUDGET=0
# SCRYDEX_API_KEY=...
# SCRYDEX_TEAM_ID=...
PRICECHARTING_ENABLED=false
PRICECHARTING_POLICY_APPROVED=false
PRICECHARTING_HOURLY_CALL_BUDGET=0
PRICECHARTING_DAILY_CALL_BUDGET=0
# PRICECHARTING_API_TOKEN=...
