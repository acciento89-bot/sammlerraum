DATABASE_URL=postgresql://sammlerraum:change-me@localhost:5432/sammlerraum
APP_ORIGIN=http://localhost:3000
# Local-process path. Docker Compose fixes the container path at /data/uploads.
UPLOADS_DIR=/var/lib/sammlerraum/uploads
LOG_LEVEL=info
WORKER_HEALTH_PORT=3001
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# Authentication. Generate BETTER_AUTH_SECRET with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google authorized redirect URI: ${APP_ORIGIN}/api/auth/callback/google
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# Apple Services ID return URL: ${APP_ORIGIN}/api/auth/callback/apple

# Required SMTP transport for email verification and password reset.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
