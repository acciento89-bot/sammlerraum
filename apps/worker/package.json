{
  "name": "@sammlerraum/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/run.ts --bundle --platform=node --format=cjs --external:sharp --outfile=dist/worker.cjs && esbuild src/main.ts --bundle --platform=node --format=cjs --outfile=dist/main.cjs",
    "dev": "esbuild src/run.ts --bundle --platform=node --format=cjs --external:sharp --outfile=dist/worker.cjs --watch",
    "lint": "prettier --check src package.json",
    "start": "node dist/worker.cjs",
    "typecheck": "tsc --noEmit --project ../../tsconfig.base.json"
  },
  "dependencies": {
    "@prisma/client": "7.10.0",
    "@sammlerraum/config": "workspace:*",
    "@sammlerraum/db": "workspace:*",
    "@sammlerraum/queue": "workspace:*",
    "@sammlerraum/storage": "workspace:*",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
