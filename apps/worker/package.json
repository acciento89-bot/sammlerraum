{
  "name": "@sammlerraum/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/run.ts --bundle --platform=node --format=cjs --external:sharp --outfile=dist/worker.cjs && esbuild src/main.ts --bundle --platform=node --format=cjs --outfile=dist/main.cjs && esbuild src/maintenance/initialize-catalog.ts --bundle --platform=node --format=cjs --outfile=dist/initialize-catalog.cjs && cp ../../docs/licenses/import-parser.txt dist/IMPORT-PARSER-LICENSES.txt",
    "dev": "esbuild src/run.ts --bundle --platform=node --format=cjs --external:sharp --outfile=dist/worker.cjs --watch",
    "lint": "prettier --check src package.json",
    "start": "node dist/worker.cjs",
    "typecheck": "tsc --noEmit --project ../../tsconfig.base.json",
    "catalog:init": "node dist/initialize-catalog.cjs"
  },
  "dependencies": {
    "@prisma/client": "7.10.0",
    "@sammlerraum/config": "workspace:*",
    "@sammlerraum/contracts": "workspace:*",
    "@sammlerraum/db": "workspace:*",
    "@sammlerraum/domain": "workspace:*",
    "@sammlerraum/market-data": "workspace:*",
    "@sammlerraum/queue": "workspace:*",
    "@sammlerraum/storage": "workspace:*",
    "csv-parse": "7.0.3",
    "saxes": "6.0.0",
    "sharp": "0.35.4",
    "yauzl": "3.4.0",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/yauzl": "3.4.0",
    "esbuild": "0.28.2"
  }
}
