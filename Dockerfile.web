FROM node:24.19.0-bookworm-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@10.17.1 --activate
WORKDIR /app

FROM base AS build
ARG NEXT_PUBLIC_APP_ORIGIN
COPY . .
RUN pnpm install --frozen-lockfile
RUN DATABASE_URL=postgresql://build:build@127.0.0.1:5432/sammlerraum_build \
    pnpm --filter @sammlerraum/db prisma generate
RUN test -n "$NEXT_PUBLIC_APP_ORIGIN"
RUN DATABASE_URL=postgresql://build:build@127.0.0.1:5432/sammlerraum_build \
    APP_ORIGIN=http://127.0.0.1:3000 \
    NEXT_PUBLIC_APP_ORIGIN=$NEXT_PUBLIC_APP_ORIGIN \
    UPLOADS_DIR=/tmp/sammlerraum-build-uploads \
    BETTER_AUTH_SECRET=build-only-secret-that-is-at-least-thirty-two-characters \
    GOOGLE_CLIENT_ID=build-only-google-client-id \
    GOOGLE_CLIENT_SECRET=build-only-google-client-secret \
    APPLE_CLIENT_ID=build-only-apple-client-id \
    APPLE_CLIENT_SECRET=build-only-apple-client-secret \
    SMTP_HOST=smtp.example.invalid \
    SMTP_PORT=587 \
    SMTP_SECURE=false \
    SMTP_USER=build-only-smtp-user \
    SMTP_PASSWORD=build-only-smtp-password \
    SMTP_FROM=noreply@example.invalid \
    pnpm --filter @sammlerraum/web build

FROM node:24.19.0-bookworm-slim AS runtime
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
WORKDIR /app
RUN mkdir -p /data/uploads && chown node:node /data/uploads
COPY --from=build --chown=node:node /app/apps/web/.next/standalone ./
COPY --from=build --chown=node:node /app/apps/web/.next/static ./apps/web/.next/static
USER node
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
