{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "vitest"]
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts", "vitest*.ts"],
  "exclude": ["**/.next/**", "**/dist/**", "**/node_modules/**"]
}
