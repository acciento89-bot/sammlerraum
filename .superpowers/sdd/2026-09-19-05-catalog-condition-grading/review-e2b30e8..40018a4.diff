+      await maintenance().setConditionOptionActive(scheme.options[0]!.id, true);
+      let release!: () => void;
+      let reached!: () => void;
+      const blocked = new Promise<void>((resolve) => {
+        release = resolve;
+      });
+      const locked = new Promise<void>((resolve) => {
+        reached = resolve;
+      });
