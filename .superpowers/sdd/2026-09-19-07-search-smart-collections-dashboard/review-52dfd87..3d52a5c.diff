diff --git a/packages/domain/src/search/search-url-integrity.test.ts b/packages/domain/src/search/search-url-integrity.test.ts
new file mode 100644
index 0000000..1de5b75
--- /dev/null
+++ b/packages/domain/src/search/search-url-integrity.test.ts
@@ -0,0 +1,99 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { parseItemSearchQuery } from "@sammlerraum/contracts/item-search";
+import { Prisma } from "@sammlerraum/db/search-sql";
+import { leaves } from "./search-compiler";
+import { runSearchRead, type SearchDatabase } from "./search-read";
+import { validateRetainedUrls } from "./search-url-integrity";
+import * as producer from "../custom-fields/custom-field-service";
+const nodes = leaves(
+  parseItemSearchQuery({
+    filter: {
+      version: 1,
+      root: {
+        kind: "customField",
+        selector: {
+          source: "CUSTOM",
+          collectionId: "00000000-0000-4000-8000-000000000001",
+          definitionId: "00000000-0000-4000-8000-000000000002",
+        },
+        predicate: { valueType: "URL", test: { op: "present" } },
+      },
+    },
+  }).filter!.root,
+);
+afterEach(() => vi.restoreAllMocks());
+describe("URL validation processing boundary", () => {
+  it("does no manifest query or producer parsing without a URL leaf", async () => {
+    const read = vi.fn(),
+      checkBudget = vi.fn(),
+      parse = vi.spyOn(producer, "validateFieldValue");
+    await validateRetainedUrls({ $queryRaw: read, checkBudget }, [], Prisma.sql`TRUE`);
+    expect(read).not.toHaveBeenCalled();
+    expect(parse).not.toHaveBeenCalled();
+    expect(checkBudget).not.toHaveBeenCalled();
+  });
+  it.each(["before read", "after read", "during parsing"] as const)(
+    "closes when the actual transaction deadline expires %s",
+    async (stage) => {
+      let now = 0,
+        reads = 0;
+      vi.spyOn(performance, "now").mockImplementation(() => now);
+      const actual = producer.validateFieldValue;
+      const parse = vi.spyOn(producer, "validateFieldValue").mockImplementation((...args) => {
+        const result = actual(...args);
+        if (stage === "during parsing") now = 5001;
+        return result;
+      });
+      const database: SearchDatabase = {
+        $transaction: async (work) =>
+          work({
+            $queryRaw: async <T>(sql: Prisma.Sql) => {
+              if (sql.text.includes("search_url_manifest")) {
+                reads++;
+                if (stage === "after read") now = 5001;
+                return [
+                  {
+                    count: 2n,
+                    bytes: 42n,
+                    values: ["https://example.org/", "https://example.net/"],
+                  },
+                ] as T;
+              }
+              return [] as T;
+            },
+          }),
+      };
+      await expect(
+        runSearchRead(database, async (tx) => {
+          if (stage === "before read") now = 5001;
+          await validateRetainedUrls(tx, nodes, Prisma.sql`TRUE`);
+          throw new Error("Must never proceed to match/count/page");
+        }),
+      ).rejects.toMatchObject({ code: "SEARCH_UNAVAILABLE" });
+      expect(reads).toBe(stage === "before read" ? 0 : 1);
+      expect(parse).toHaveBeenCalledTimes(stage === "during parsing" ? 1 : 0);
+    },
+  );
+  it("closes raw manifest driver failures without parsing or exposing values", async () => {
+    const parse = vi.spyOn(producer, "validateFieldValue");
+    const database: SearchDatabase = {
+      $transaction: async (work) =>
+        work({
+          $queryRaw: async <T>(sql: Prisma.Sql) => {
+            if (sql.text.includes("search_url_manifest"))
+              throw {
+                code: "P2010",
+                meta: { code: "57014", message: "https://private.invalid/secret" },
+              };
+            return [] as T;
+          },
+        }),
+    };
+    const error = await runSearchRead(database, (tx) =>
+      validateRetainedUrls(tx, nodes, Prisma.sql`TRUE`),
+    ).catch((error) => error);
+    expect(error).toMatchObject({ code: "SEARCH_UNAVAILABLE", message: "SEARCH_UNAVAILABLE" });
+    expect(JSON.stringify(error)).not.toContain("private");
+    expect(parse).not.toHaveBeenCalled();
+  });
+});
diff --git a/packages/domain/src/search/search-url-integrity.ts b/packages/domain/src/search/search-url-integrity.ts
new file mode 100644
index 0000000..88cce0b
--- /dev/null
+++ b/packages/domain/src/search/search-url-integrity.ts
@@ -0,0 +1,83 @@
+import { Prisma } from "@sammlerraum/db/search-sql";
+import type { ItemFilterLeaf } from "@sammlerraum/contracts/search";
+import { searchFail } from "@sammlerraum/contracts/item-search";
+import { validateFieldValue } from "../custom-fields/custom-field-service";
+import { candidateFrom, exactCatalog, or } from "./search-compiler";
+import type { BoundedSearchReadTransaction } from "./search-read";
+
+/** The existing producer owns WHATWG URL validity and canonical serialization.
+ * Only distinct selected values cross this internal seam, never item inventories. */
+export async function validateRetainedUrls(
+  tx: BoundedSearchReadTransaction,
+  nodes: ItemFilterLeaf[],
+  outer: Prisma.Sql,
+): Promise<void> {
+  const custom: Prisma.Sql[] = [],
+    catalog: Prisma.Sql[] = [];
+  const seen = new Set<string>();
+  for (const node of nodes) {
+    if (
+      (node.kind !== "customField" && node.kind !== "catalogAttribute") ||
+      node.predicate.valueType !== "URL"
+    )
+      continue;
+    const key = JSON.stringify([node.kind, node.selector]);
+    if (seen.has(key)) continue;
+    seen.add(key);
+    if (node.kind === "customField")
+      custom.push(
+        Prisma.sql`i."collectionId"=${node.selector.collectionId}::uuid AND v."fieldDefinitionId"=${node.selector.definitionId}::uuid`,
+      );
+    else
+      catalog.push(
+        Prisma.sql`i."categoryTemplateId"=${node.selector.categoryTemplateId}::uuid AND ${exactCatalog(node)}`,
+      );
+  }
+  if (!seen.size) return;
+  const sources: Prisma.Sql[] = [];
+  if (custom.length)
+    sources.push(
+      Prisma.sql`SELECT v."urlValue" AS value ${candidateFrom} JOIN "CustomFieldValue" v ON v."itemId"=i.id AND v."collectionId"=i."collectionId" AND v."fieldType"='URL' WHERE ${outer} AND ${or(custom)}`,
+    );
+  if (catalog.length)
+    sources.push(
+      Prisma.sql`SELECT CASE WHEN jsonb_typeof(a.value)='string' THEN a.value #>> '{}' ELSE NULL END AS value ${candidateFrom} JOIN "CatalogAttributeValue" a ON a."entryId"=i."catalogEntryId" AND a."categoryTemplateId"=i."categoryTemplateId" WHERE ${outer} AND ${or(catalog)}`,
+    );
+  tx.checkBudget();
+  const [manifest] = await tx.$queryRaw<
+    { count: bigint; bytes: bigint; values: string[] | null }[]
+  >(Prisma.sql`
+    WITH search_url_manifest AS MATERIALIZED (
+      SELECT DISTINCT value COLLATE pg_catalog."C" AS value FROM (${Prisma.join(sources, " UNION ALL ")}) selected_urls LIMIT 4097
+    ), sizes AS (
+      SELECT count(*) AS count, COALESCE(sum(octet_length(value)),0)::bigint AS bytes FROM search_url_manifest
+    )
+    SELECT count,bytes,CASE WHEN count<=4096 AND bytes<=8388608
+      THEN (SELECT array_agg(value) FROM search_url_manifest) ELSE NULL END AS values FROM sizes
+  `);
+  tx.checkBudget();
+  if (
+    !manifest ||
+    typeof manifest.count !== "bigint" ||
+    typeof manifest.bytes !== "bigint" ||
+    manifest.count < 0n ||
+    manifest.bytes < 0n
+  )
+    return searchFail("SEARCH_INVARIANT");
+  if (manifest.count > 4096n || manifest.bytes > 8388608n) return searchFail("SEARCH_UNAVAILABLE");
+  if (manifest.count === 0n && manifest.values === null) return;
+  if (!Array.isArray(manifest.values) || BigInt(manifest.values.length) !== manifest.count)
+    return searchFail("SEARCH_INVARIANT");
+  for (const value of manifest.values) {
+    tx.checkBudget();
+    let valid = false;
+    try {
+      valid = typeof value === "string" && validateFieldValue("URL", value) === value;
+    } catch {
+      /* Only the closed invariant code may leave this seam. */
+    }
+    tx.checkBudget();
+    if (!valid) return searchFail("SEARCH_INVARIANT");
+  }
+  tx.checkBudget();
+}
