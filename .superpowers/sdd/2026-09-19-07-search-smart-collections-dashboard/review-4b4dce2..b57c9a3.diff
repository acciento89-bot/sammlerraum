@@ -0,0 +1,54 @@
+import { describe, expect, it } from "vitest";
+import { parseItemSearchQuery } from "@sammlerraum/contracts/item-search";
+import { decodeSearchCursor, encodeSearchCursor, searchContextHash } from "./search-cursor";
+
+describe("strict owned search input and cursor", () => {
+  it("normalizes bounded text and keeps explicit null filter", () => {
+    expect(parseItemSearchQuery({ text: "  Ａ  ", filter: null })).toEqual({
+      text: "A",
+      filter: null,
+      lifecycle: "ACTIVE",
+      limit: 20,
+    });
+  });
+  it.each([
+    { ownerId: "foreign" },
+    { scope: "PUBLIC" },
+    { sort: "title" },
+    { limit: "2" },
+    { limit: 0 },
+    { limit: 51 },
+    { text: "x".repeat(201) },
+    { text: "\ud800" },
+    { text: "\0" },
+    { text: "ﷺ".repeat(200) },
+  ])("rejects invalid query %# without payload", (input) => {
+    expect(() => parseItemSearchQuery(input)).toThrow("SEARCH_INVALID");
+  });
+  it("binds canonical cursor to actor, filter, lifecycle, size and saved revision", () => {
+    const query = parseItemSearchQuery({});
+    const hash = searchContextHash("a", query, null);
+    const cursor = {
+      v: 1 as const,
+      contextHash: hash,
+      after: { createdAt: "2026-01-01T00:00:00.000Z", id: "00000000-0000-4000-8000-000000000001" },
+    };
+    const token = encodeSearchCursor(cursor);
+    expect(decodeSearchCursor(token, hash)).toEqual(cursor);
+    for (const next of [
+      searchContextHash("b", query, null),
+      searchContextHash("a", { ...query, text: "x" }, null),
+      searchContextHash("a", { ...query, lifecycle: "ALL" }, null),
+      searchContextHash("a", { ...query, limit: 1 }, null),
+      searchContextHash("a", query, { smartCollectionId: cursor.after.id, revision: 1 }),
+    ])
+      expect(() => decodeSearchCursor(token, next)).toThrow("SEARCH_INVALID");
+    for (const invalid of [
+      token + "=",
+      "_w",
+      Buffer.from(JSON.stringify({ ...cursor, extra: 1 })).toString("base64url"),
+      Buffer.from(JSON.stringify(cursor, null, 2)).toString("base64url"),
+    ])
+      expect(() => decodeSearchCursor(invalid, hash)).toThrow("SEARCH_INVALID");
+  });
+});
diff --git a/packages/domain/src/search/search-read.integration.test.ts b/packages/domain/src/search/search-read.integration.test.ts
new file mode 100644
index 0000000..6e741b3
--- /dev/null
+++ b/packages/domain/src/search/search-read.integration.test.ts
@@ -0,0 +1,174 @@
+import { afterAll, describe, expect, it } from "vitest";
+import { createPrismaClient } from "@sammlerraum/db/create-client";
+import { createTestDatabaseClient } from "@sammlerraum/db/test-database";
+import { Prisma } from "@sammlerraum/db/search-sql";
+import { runSearchRead, type SearchDatabase } from "./search-read";
+import { errorCode, isReadDependencyFailure } from "../api/read-dependency-errors";
+const enabled = process.env.RUN_DATABASE_INTEGRATION === "1";
+const db = enabled ? createTestDatabaseClient() : undefined;
+afterAll(async () => db?.$disconnect());
+describe.runIf(enabled)("native search transaction dependency behavior", () => {
+  it("configures actual RepeatableRead/UTC/statement/lock/transaction budgets", async () => {
+    const rows = await runSearchRead(db!, (tx) =>
+      tx.$queryRaw<
+        {
+          isolation: string;
+          timezone: string;
+          statement: string;
+          lock: string;
+          transaction: string;
+        }[]
+      >(
+        Prisma.sql`SELECT current_setting('transaction_isolation') AS isolation,current_setting('TimeZone') AS timezone,current_setting('statement_timeout') AS statement,current_setting('lock_timeout') AS lock,current_setting('transaction_timeout') AS transaction`,
+      ),
+    );
+    expect(rows[0]).toMatchObject({
+      isolation: "repeatable read",
+      timezone: "UTC",
+      statement: "2s",
+      lock: "500ms",
+    });
+    expect(rows[0]!.transaction).toMatch(/^(?:[1-4][0-9]{3}ms|5s)$/u);
+  });
+  it("settles a real statement timeout and maps captured installed-driver error", async () => {
+    let captured: unknown;
+    const wrapped: SearchDatabase = {
+      $transaction: (work, options) =>
+        db!.$transaction(
+          (tx) =>
+            work({
+              $queryRaw: async <T>(sql: Prisma.Sql) => {
+                try {
+                  return await tx.$queryRaw<T>(sql);
+                } catch (error) {
+                  captured = error;
+                  throw error;
+                }
+              },
+            }),
+          options,
+        ),
+    };
+    const start = performance.now();
+    await expect(
+      runSearchRead(wrapped, (tx) => tx.$queryRaw(Prisma.sql`SELECT pg_sleep(3)`)),
+    ).rejects.toMatchObject({ code: "SEARCH_UNAVAILABLE" });
+    expect(performance.now() - start).toBeLessThan(5000);
+    expect(errorCode(captured)).toBe("57014");
+    expect(isReadDependencyFailure(captured)).toBe(true);
+    console.info(
+      "native search timeout mapping",
+      JSON.stringify({
+        outerCode: (captured as { code: string }).code,
+        recognizedCode: errorCode(captured),
+      }),
+    );
+  }, 7000);
+  it("recognizes real serialization errors and retries exactly three transactions", async () => {
+    let attempts = 0,
+      captured: unknown;
+    const wrapped: SearchDatabase = {
+      $transaction: async (work, options) => {
+        attempts++;
+        return db!.$transaction(async (tx) => {
+          try {
+            return await work(tx);
+          } catch (error) {
+            captured = error;
+            throw error;
+          }
+        }, options);
+      },
+    };
+    await expect(
+      runSearchRead(wrapped, (tx) =>
+        tx.$queryRaw(
+          Prisma.sql`DO $$ BEGIN RAISE EXCEPTION 'synthetic search serialization' USING ERRCODE='40001'; END $$`,
+        ),
+      ),
+    ).rejects.toMatchObject({ code: "SEARCH_UNAVAILABLE" });
+    expect(attempts).toBe(3);
+    expect(errorCode(captured)).toBe("40001");
+    console.info(
+      "native search serialization mapping",
+      JSON.stringify({
+        outerCode: (captured as { code: string }).code,
+        recognizedCode: errorCode(captured),
+        attempts,
+      }),
+    );
+  });
+  it("maps actual lock timeout without returning a partial result", async () => {
+    let release!: () => void, locked!: () => void;
+    const held = new Promise<void>((resolve) => (release = resolve)),
+      ready = new Promise<void>((resolve) => (locked = resolve));
+    const locker = db!.$transaction(
+      async (tx) => {
+        await tx.$queryRaw`SELECT pg_advisory_xact_lock(780714)::text`;
+        locked();
+        await held;
+      },
+      { timeout: 5000 },
+    );
+    await ready;
+    try {
+      await expect(
+        runSearchRead(db!, (tx) =>
+          tx.$queryRaw(Prisma.sql`SELECT pg_advisory_xact_lock(780714)::text`),
+        ),
+      ).rejects.toMatchObject({ code: "SEARCH_UNAVAILABLE" });
+    } finally {
+      release();
+      await locker;
+    }
+  });
+  it("bounds real exhausted pool acquisition and closes the installed driver failure", async () => {
+    const pool = createPrismaClient(process.env.DATABASE_URL!, { bounded: true });
+    let release!: () => void;
+    const held = new Promise<void>((resolve) => (release = resolve));
+    let acquired = 0,
+      ready!: () => void;
+    const allReady = new Promise<void>((resolve) => (ready = resolve));
+    const lockers = Array.from({ length: 10 }, () =>
+      pool.$transaction(
+        async (tx) => {
+          await tx.$queryRaw`SELECT 1`;
+          if (++acquired === 10) ready();
+          await held;
+        },
+        { maxWait: 2000, timeout: 10000 },
+      ),
+    );
+    await allReady;
+    let captured: unknown;
+    const wrapped: SearchDatabase = {
+      $transaction: async (work, options) => {
+        try {
+          return await pool.$transaction(work, options);
+        } catch (error) {
+          captured = error;
+          throw error;
+        }
+      },
+    };
+    const start = performance.now();
+    try {
+      await expect(
+        runSearchRead(wrapped, (tx) => tx.$queryRaw(Prisma.sql`SELECT 1`)),
+      ).rejects.toMatchObject({ code: "SEARCH_UNAVAILABLE" });
+      expect(performance.now() - start).toBeLessThan(5000);
+      expect(isReadDependencyFailure(captured)).toBe(true);
+      console.info(
+        "native search pool mapping",
+        JSON.stringify({
+          outerCode: (captured as { code?: string }).code,
+          recognizedCode: errorCode(captured),
+        }),
+      );
+    } finally {
+      release();
+      await Promise.all(lockers);
+      await pool.$disconnect();
+    }
+  }, 10000);
+});
diff --git a/packages/domain/src/search/search-read.test.ts b/packages/domain/src/search/search-read.test.ts
new file mode 100644
index 0000000..51c2e30
--- /dev/null
+++ b/packages/domain/src/search/search-read.test.ts
@@ -0,0 +1,116 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { Prisma } from "@sammlerraum/db/search-sql";
+import { runSearchRead, type SearchDatabase } from "./search-read";
+import { checkedSearchTotal } from "./item-search-service";
+import { isReadDependencyFailure } from "../api/read-dependency-errors";
+afterEach(() => vi.restoreAllMocks());
+describe("search read processing budgets", () => {
+  it("rejects count overflow without rounding", () => {
+    expect(checkedSearchTotal(9007199254740991n)).toBe(Number.MAX_SAFE_INTEGER);
+    for (const value of [-1n, 9007199254740992n])
+      expect(() => checkedSearchTotal(value)).toThrow("SEARCH_INVARIANT");
+  });
+  it("does not return work after the transaction's budget expired", async () => {
+    let time = 0;
+    vi.spyOn(performance, "now").mockImplementation(() => time);
+    const database: SearchDatabase = {
+      $transaction: async (work) => work({ $queryRaw: async <T>() => [] as T }),
+    };
+    await expect(
+      runSearchRead(database, async () => {
+        time = 5001;
+        return "late";
+      }),
+    ).rejects.toMatchObject({ code: "SEARCH_UNAVAILABLE" });
+  });
+  it("accounts for acquisition against the total budget", async () => {
+    let time = 0;
+    vi.spyOn(performance, "now").mockImplementation(() => time);
+    let calls = 0;
+    const database: SearchDatabase = {
+      $transaction: async (work, options) => {
+        expect(options.maxWait).toBe(2000);
+        time = 11999;
+        return work({
+          $queryRaw: async <T>() => {
+            calls++;
+            time = 12001;
+            return [] as T;
+          },
+        });
+      },
+    };
+    await expect(runSearchRead(database, async () => "partial")).rejects.toMatchObject({
+      code: "SEARCH_UNAVAILABLE",
+    });
+    expect(calls).toBe(1);
+  });
+  it("restarts the entire transaction for at most three recognized serialization failures", async () => {
+    let attempts = 0,
+      works = 0;
+    const database: SearchDatabase = {
+      $transaction: async (work) => {
+        attempts++;
+        await work({ $queryRaw: async <T>() => [] as T });
+        throw { code: "P2010", meta: { driverAdapterError: { cause: { originalCode: "40001" } } } };
+      },
+    };
+    await expect(
+      runSearchRead(database, async () => {
+        works++;
+        return "uncommitted";
+      }),
+    ).rejects.toMatchObject({ code: "SEARCH_UNAVAILABLE" });
+    expect(attempts).toBe(3);
+    expect(works).toBe(3);
+  });
+  it("does not retry once overall time is spent, or retry arbitrary database errors", async () => {
+    let time = 0,
+      attempts = 0;
+    vi.spyOn(performance, "now").mockImplementation(() => time);
+    const database: SearchDatabase = {
+      $transaction: async () => {
+        attempts++;
+        time = 12001;
+        throw { code: "40001" };
+      },
+    };
+    await expect(runSearchRead(database, async () => "partial")).rejects.toMatchObject({
+      code: "SEARCH_UNAVAILABLE",
+    });
+    expect(attempts).toBe(1);
+    expect(isReadDependencyFailure({ message: "57014 fake secret" })).toBe(false);
+    await expect(
+      runSearchRead(
+        {
+          $transaction: async () => {
+            throw { message: "secret" };
+          },
+        },
+        async () => "partial",
+      ),
+    ).rejects.toMatchObject({ code: "SEARCH_INVARIANT" });
+  });
+  it("checks remaining budget after SQL and before subsequent SQL", async () => {
+    let time = 0,
+      statements = 0;
+    vi.spyOn(performance, "now").mockImplementation(() => time);
+    const database: SearchDatabase = {
+      $transaction: async (work) =>
+        work({
+          $queryRaw: async <T>(sql: Prisma.Sql) => {
+            statements++;
+            if (sql.text === "SELECT 1") time = 5001;
+            return [] as T;
+          },
+        }),
+    };
+    await expect(
+      runSearchRead(database, async (tx) => {
+        await tx.$queryRaw(Prisma.sql`SELECT 1`);
+        return tx.$queryRaw(Prisma.sql`SELECT 2`);
+      }),
+    ).rejects.toMatchObject({ code: "SEARCH_UNAVAILABLE" });
+    expect(statements).toBe(3);
+  });
+});
diff --git a/packages/domain/src/search/search-read.ts b/packages/domain/src/search/search-read.ts
new file mode 100644
index 0000000..4c30b61
--- /dev/null
+++ b/packages/domain/src/search/search-read.ts
@@ -0,0 +1,70 @@
+import { Prisma } from "@sammlerraum/db/search-sql";
+import { ItemSearchError, searchFail } from "@sammlerraum/contracts/item-search";
+import { FilterValidationError } from "@sammlerraum/contracts/search";
+import { isReadDependencyFailure, isReadSerializationFailure } from "../api/read-dependency-errors";
+export type SearchReadTransaction = { $queryRaw<T>(sql: Prisma.Sql): Promise<T> };
+export type SearchDatabase = {
+  $transaction<T>(
+    work: (tx: SearchReadTransaction) => Promise<T>,
+    options: { isolationLevel: "RepeatableRead"; maxWait: number; timeout: number },
+  ): Promise<T>;
+};
+/** Entire read retries within 12s; no locks or snapshot survive a response. */
+export async function runSearchRead<T>(
+  database: SearchDatabase,
+  work: (tx: SearchReadTransaction) => Promise<T>,
+): Promise<T> {
+  const stop = performance.now() + 12000;
+  for (let attempt = 0; attempt < 3; attempt++) {
+    const remaining = Math.floor(stop - performance.now());
+    if (remaining < 1) return searchFail("SEARCH_UNAVAILABLE");
+    try {
+      const result = await database.$transaction(
+        async (raw) => {
+          const txStop = Math.min(stop, performance.now() + 5000);
+          const budget = () => {
+            const left = Math.floor(txStop - performance.now());
+            if (left < 1) return searchFail("SEARCH_UNAVAILABLE");
+            return left;
+          };
+          const first = budget();
+          await raw.$queryRaw(
+            Prisma.sql`SELECT set_config('TimeZone','UTC',true),set_config('statement_timeout',${`${Math.min(2000, first)}ms`},true),set_config('lock_timeout',${`${Math.min(500, first)}ms`},true),set_config('transaction_timeout',${`${first}ms`},true)`,
+          );
+          budget();
+          const tx: SearchReadTransaction = {
+            $queryRaw: async <T>(query: Prisma.Sql) => {
+              const left = budget();
+              await raw.$queryRaw(
+                Prisma.sql`SELECT set_config('statement_timeout',${`${Math.min(2000, left)}ms`},true),set_config('lock_timeout',${`${Math.min(500, left)}ms`},true)`,
+              );
+              budget();
+              const rows = await raw.$queryRaw<T>(query);
+              budget();
+              return rows;
+            },
+          };
+          const result = await work(tx);
+          budget();
+          return result;
+        },
+        {
+          isolationLevel: "RepeatableRead",
+          maxWait: Math.min(2000, remaining),
+          timeout: Math.min(5000, remaining),
+        },
+      );
+      if (performance.now() >= stop) return searchFail("SEARCH_UNAVAILABLE");
+      return result;
+    } catch (error) {
+      if (error instanceof ItemSearchError || error instanceof FilterValidationError) throw error;
+      if (isReadSerializationFailure(error) && attempt < 2 && performance.now() < stop) continue;
+      if (isReadDependencyFailure(error)) return searchFail("SEARCH_UNAVAILABLE");
+      // This compiler's only named collation is a deployment dependency. Never expose SQL.
+      const code = (error as { meta?: { code?: unknown } } | null)?.meta?.code;
+      if (code === "42704") return searchFail("SEARCH_UNAVAILABLE");
+      return searchFail("SEARCH_INVARIANT");
+    }
+  }
+  return searchFail("SEARCH_UNAVAILABLE");
+}
diff --git a/packages/domain/src/search/search-text.ts b/packages/domain/src/search/search-text.ts
new file mode 100644
index 0000000..0815e79
--- /dev/null
+++ b/packages/domain/src/search/search-text.ts
@@ -0,0 +1,41 @@
+import { Prisma } from "@sammlerraum/db/search-sql";
+import { catalogGuard } from "./search-typed-guards";
+import { or } from "./search-compiler";
+const selected = Prisma.sql`a."entryId"=i."catalogEntryId" AND a."categoryTemplateId"=i."categoryTemplateId" AND ((a."variantId" IS NULL AND a."targetKey"='entry') OR (a."variantId"=i."catalogVariantId" AND a."targetKey"=i."catalogVariantId"::text))`;
+const catalogFrom = Prisma.sql`FROM "CatalogAttributeValue" a JOIN "CatalogAttributeDefinition" d ON d.id=a."definitionId" AND d."categoryTemplateId"=a."categoryTemplateId"`;
+const relevant = Prisma.sql`d.type IN ('SHORT_TEXT','LONG_TEXT','SINGLE_SELECT','MULTI_SELECT')`;
+const guards = Prisma.sql`CASE d.type WHEN 'SHORT_TEXT' THEN ${catalogGuard("SHORT_TEXT")} WHEN 'LONG_TEXT' THEN ${catalogGuard("LONG_TEXT")} WHEN 'SINGLE_SELECT' THEN ${catalogGuard("SINGLE_SELECT")} WHEN 'MULTI_SELECT' THEN ${catalogGuard("MULTI_SELECT")} ELSE TRUE END`;
+export const invalidBroadFacts = Prisma.sql`EXISTS(SELECT 1 ${catalogFrom} WHERE ${selected} AND ${relevant} AND NOT COALESCE((${guards}),FALSE))`;
+/** Broad text is literal NFKC/ILIKE with the fixed deterministic root ICU collation. */
+export function compileBroadText(query: string, owner: string): Prisma.Sql {
+  const pattern = `%${query.replace(/[\\%_]/gu, (c) => `\\${c}`)}%`;
+  const matches = (column: Prisma.Sql) =>
+    Prisma.sql`COALESCE(normalize(${column},NFKC) COLLATE pg_catalog."und-x-icu" ILIKE ${pattern} ESCAPE ${"\\"},FALSE)`;
+  const title = (column: Prisma.Sql) =>
+    or([
+      Prisma.sql`CASE WHEN jsonb_typeof(${column}->'text'->'title')='string' THEN ${matches(Prisma.sql`${column}->'text'->>'title'`)} ELSE FALSE END`,
+      Prisma.sql`EXISTS(SELECT 1 FROM jsonb_array_elements(CASE WHEN jsonb_typeof(${column}->'text'->'translations')='array' THEN ${column}->'text'->'translations' ELSE '[]'::jsonb END) tr WHERE jsonb_typeof(tr->'title')='string' AND ${matches(Prisma.sql`tr->>'title'`)})`,
+    ]);
+  return or([
+    matches(Prisma.sql`i.title`),
+    matches(Prisma.sql`i."publicDescription"`),
+    Prisma.sql`EXISTS(SELECT 1 FROM "ItemTag" it JOIN "Tag" t ON t.id=it."tagId" WHERE it."itemId"=i.id AND t."ownerId"=${owner} AND ${matches(Prisma.sql`t."normalizedName"`)})`,
+    Prisma.sql`EXISTS(SELECT 1 FROM "ItemIdentifier" x WHERE x."itemId"=i.id AND ${matches(Prisma.sql`x.value`)})`,
+    Prisma.sql`EXISTS(SELECT 1 FROM "Grading" g WHERE g."itemId"=i.id AND g."ownerId"=${owner} AND ${or([matches(Prisma.sql`g.provider`), matches(Prisma.sql`g.grade`), matches(Prisma.sql`g."certificateNo"`)])})`,
+    Prisma.sql`EXISTS(SELECT 1 FROM "CustomFieldValue" v WHERE v."itemId"=i.id AND v."collectionId"=i."collectionId" AND ${or(
+      [
+        Prisma.sql`v."fieldType"='SHORT_TEXT' AND ${matches(Prisma.sql`v."shortTextValue"`)}`,
+        Prisma.sql`v."fieldType"='LONG_TEXT' AND ${matches(Prisma.sql`v."longTextValue"`)}`,
+        Prisma.sql`v."fieldType"='SINGLE_SELECT' AND EXISTS(SELECT 1 FROM "CustomFieldOption" o WHERE o.id=v."singleSelectOptionId" AND o."fieldDefinitionId"=v."fieldDefinitionId" AND ${matches(Prisma.sql`o.value`)})`,
+        Prisma.sql`v."fieldType"='MULTI_SELECT' AND EXISTS(SELECT 1 FROM "CustomFieldMultiSelectValue" mv JOIN "CustomFieldOption" o ON o.id=mv."optionId" AND o."fieldDefinitionId"=mv."fieldDefinitionId" WHERE mv."itemId"=v."itemId" AND mv."fieldDefinitionId"=v."fieldDefinitionId" AND ${matches(Prisma.sql`o.value`)})`,
+      ],
+    )})`,
+    Prisma.sql`EXISTS(SELECT 1 FROM "CategoryTemplateLabel" l WHERE l."categoryTemplateId"=i."categoryTemplateId" AND l.locale IN ('de','en') AND ${matches(Prisma.sql`l.label`)})`,
+    Prisma.sql`EXISTS(SELECT 1 FROM "CatalogEntry" e WHERE e.id=i."catalogEntryId" AND e."categoryTemplateId"=i."categoryTemplateId" AND ${title(Prisma.sql`e.authored`)})`,
+    Prisma.sql`EXISTS(SELECT 1 FROM "CatalogVariant" e WHERE e.id=i."catalogVariantId" AND e."entryId"=i."catalogEntryId" AND ${title(Prisma.sql`e.authored`)})`,
+    Prisma.sql`EXISTS(SELECT 1 ${catalogFrom} WHERE ${selected} AND ${relevant} AND ${or([
+      Prisma.sql`d.type IN ('SHORT_TEXT','LONG_TEXT','SINGLE_SELECT') AND ${matches(Prisma.sql`a.value #>> '{}'`)}`,
+      Prisma.sql`d.type IN ('SINGLE_SELECT','MULTI_SELECT') AND EXISTS(SELECT 1 FROM "CatalogAttributeOption" o LEFT JOIN "CatalogAttributeOptionLabel" l ON l."optionId"=o.id AND l.locale IN ('de','en') WHERE o."definitionId"=a."definitionId" AND ((d.type='SINGLE_SELECT' AND o.key COLLATE pg_catalog."C"=(a.value #>> '{}')) OR (d.type='MULTI_SELECT' AND a.value @> jsonb_build_array(o.key))) AND ${or([matches(Prisma.sql`o.key`), matches(Prisma.sql`l.label`)])})`,
+    ])})`,
+  ]);
+}
diff --git a/packages/domain/src/search/search-typed-guards.ts b/packages/domain/src/search/search-typed-guards.ts
new file mode 100644
index 0000000..1a875ed
--- /dev/null
+++ b/packages/domain/src/search/search-typed-guards.ts
@@ -0,0 +1,52 @@
+import { Prisma } from "@sammlerraum/db/search-sql";
+import type { CustomFieldType } from "@sammlerraum/contracts/custom-fields";
+const text = Prisma.sql`(a.value #>> '{}')`;
+const string = Prisma.sql`jsonb_typeof(a.value)='string'`;
+const array = Prisma.sql`CASE WHEN jsonb_typeof(a.value)='array' THEN a.value ELSE '[]'::jsonb END`;
+export function catalogGuard(type: CustomFieldType): Prisma.Sql {
+  switch (type) {
+    case "SHORT_TEXT":
+    case "LONG_TEXT":
+      return Prisma.sql`${string} AND char_length(${text}) BETWEEN 1 AND ${type === "SHORT_TEXT" ? 255 : 10000} AND ${text}=normalize(btrim(${text}),NFKC) COLLATE pg_catalog."C"`;
+    case "URL":
+      return Prisma.sql`${string} AND char_length(${text})<=2048 AND ${text} ~ '^https?://[^/@[:space:]]+[^[:space:]]*$'`;
+    case "INTEGER":
+      return Prisma.sql`CASE WHEN jsonb_typeof(a.value)='number' AND ${text} ~ '^-?(0|[1-9][0-9]*)$' AND char_length(${text})<=17 THEN ${text}::numeric BETWEEN -9007199254740991 AND 9007199254740991 ELSE FALSE END`;
+    case "DECIMAL":
+      return Prisma.sql`${string} AND ${text} ~ '^-?(0|[1-9][0-9]{0,19})([.][0-9]{0,17}[1-9])?$' AND ${text}<>'-0'`;
+    case "DATE":
+      return Prisma.sql`CASE WHEN ${string} AND ${text} ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' AND left(${text},4)<>'0000' AND pg_input_is_valid(${text},'date') THEN to_char(${text}::date,'YYYY-MM-DD')=${text} ELSE FALSE END`;
+    case "BOOLEAN":
+      return Prisma.sql`jsonb_typeof(a.value)='boolean'`;
+    case "SINGLE_SELECT":
+      return Prisma.sql`${string} AND EXISTS(SELECT 1 FROM "CatalogAttributeOption" o WHERE o."definitionId"=a."definitionId" AND o.key COLLATE pg_catalog."C"=${text})`;
+    case "MULTI_SELECT":
+      return Prisma.sql`jsonb_typeof(a.value)='array' AND jsonb_array_length(${array})<=100 AND NOT EXISTS(SELECT 1 FROM jsonb_array_elements(${array}) e(value) WHERE jsonb_typeof(e.value)<>'string' OR NOT EXISTS(SELECT 1 FROM "CatalogAttributeOption" o WHERE o."definitionId"=a."definitionId" AND o.key COLLATE pg_catalog."C"=(e.value #>> '{}'))) AND (SELECT count(*)=count(DISTINCT e.value) FROM jsonb_array_elements(${array}) e(value))`;
+    case "MONEY":
+      return Prisma.sql`CASE WHEN jsonb_typeof(a.value)='object' AND jsonb_typeof(a.value->'amountMinor')='number' AND (a.value->>'amountMinor') ~ '^(0|[1-9][0-9]{0,15})$' AND jsonb_typeof(a.value->'currency')='string' AND (a.value->>'currency') ~ '^[A-Z]{3}$' AND (CASE WHEN jsonb_typeof(a.value)='object' THEN a.value ELSE '{}'::jsonb END) - 'amountMinor' - 'currency' = '{}'::jsonb THEN (a.value->>'amountMinor')::numeric BETWEEN 0 AND 9007199254740991 ELSE FALSE END`;
+  }
+}
+export function catalogScalar(type: CustomFieldType): Prisma.Sql {
+  const valid = catalogGuard(type);
+  if (type === "INTEGER" || type === "DECIMAL")
+    return Prisma.sql`CASE WHEN ${valid} THEN ${text}::numeric ELSE NULL END`;
+  if (type === "DATE") return Prisma.sql`CASE WHEN ${valid} THEN ${text}::date ELSE NULL END`;
+  if (type === "BOOLEAN") return Prisma.sql`CASE WHEN ${valid} THEN ${text}::boolean ELSE NULL END`;
+  return Prisma.sql`CASE WHEN ${valid} THEN ${text} ELSE NULL END`;
+}
+/** SQL constraints protect native discriminants and paired columns. These guards
+ * cover values the native date/numeric/text types can hold outside producer bounds. */
+export function customGuard(type: CustomFieldType): Prisma.Sql {
+  switch (type) {
+    case "DECIMAL":
+      return Prisma.sql`v."decimalValue" IS NOT NULL AND v."decimalValue"::text NOT IN ('NaN','Infinity','-Infinity')`;
+    case "DATE":
+      return Prisma.sql`v."dateValue" BETWEEN DATE '0001-01-01' AND DATE '9999-12-31'`;
+    case "SHORT_TEXT":
+      return Prisma.sql`v."shortTextValue"=normalize(btrim(v."shortTextValue"),NFKC) COLLATE pg_catalog."C"`;
+    case "LONG_TEXT":
+      return Prisma.sql`v."longTextValue"=normalize(btrim(v."longTextValue"),NFKC) COLLATE pg_catalog."C"`;
+    default:
+      return Prisma.sql`TRUE`;
+  }
+}
