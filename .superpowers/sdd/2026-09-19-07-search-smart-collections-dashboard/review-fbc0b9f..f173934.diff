+        state: "AVAILABLE",
+        collection: { id: collection, name: "Owned route label" },
+      },
+    ]);
+    expect(session).toHaveBeenCalledWith(
+      expect.objectContaining({ query: { disableCookieCache: true, disableRefresh: true } }),
+    );
