@@ -0,0 +1,332 @@
+type Schema<T> = { safeParse(value: unknown): { success: true; data: T } | { success: false } };
+import { searchFail } from "@sammlerraum/contracts/item-search";
+import * as contract from "@sammlerraum/contracts/search-references";
+import { CategorySummarySchema } from "@sammlerraum/contracts/catalog-reads";
+import type { SearchActor } from "./item-search-service";
+import {
+  runSearchRead,
+  type SearchDatabase,
+  type BoundedSearchReadTransaction,
+} from "./search-read";
+import {
+  decodeReferenceCursor,
+  encodeReferenceCursor,
+  referenceContextHash,
+} from "./search-reference-cursor";
+import * as sql from "./search-reference-sql";
+import type { Prisma } from "@sammlerraum/db/search-sql";
+function actorId(actor: SearchActor) {
+  if (!actor || typeof actor.userId !== "string" || !actor.userId || actor.userId.includes("\0"))
+    return searchFail("SEARCH_INVALID");
+  return actor.userId;
+}
+function checked<T>(schema: Schema<T>, value: unknown): T {
+  const result = schema.safeParse(value);
+  if (!result.success) return searchFail("SEARCH_INVARIANT");
+  return result.data;
+}
+/** A bounded producer DTO and serialization remain inside the snapshot/time budget. */
+export function finishReference<T>(
+  tx: Pick<BoundedSearchReadTransaction, "checkBudget">,
+  schema: Schema<T>,
+  value: unknown,
+): T {
+  tx.checkBudget();
+  const result = checked(schema, value);
+  tx.checkBudget();
+  const bytes = Buffer.byteLength(JSON.stringify(result));
+  tx.checkBudget();
+  if (bytes > contract.REFERENCE_MAX_RESPONSE_BYTES) return searchFail("SEARCH_UNAVAILABLE");
+  return result;
+}
+async function read(tx: BoundedSearchReadTransaction, query: Prisma.Sql) {
+  const rows = await tx.$queryRaw<{ readAt: Date; payload: unknown }[]>(query);
+  if (
+    rows.length !== 1 ||
+    !(rows[0]!.readAt instanceof Date) ||
+    !Number.isFinite(rows[0]!.readAt.getTime())
+  )
+    return searchFail("SEARCH_INVARIANT");
+  return { readAt: rows[0]!.readAt.toISOString(), payload: rows[0]!.payload };
+}
+function cap(values: unknown[], max: number) {
+  if (values.length > max) searchFail("SEARCH_UNAVAILABLE");
+}
+function pagination(
+  actor: string,
+  family: contract.ReferenceFamily,
+  parent: string | null,
+  input: { limit: number; cursor?: string | undefined },
+) {
+  const hash = referenceContextHash(actor, family, parent, input.limit);
+  return {
+    after: input.cursor ? decodeReferenceCursor(input.cursor, hash) : null,
+    next: (rows: { id: string }[]) =>
+      rows.length > input.limit
+        ? encodeReferenceCursor({ v: 1, contextHash: hash, after: rows[input.limit - 1]!.id })
+        : null,
+  };
+}
+export function createSearchReferenceService(database: SearchDatabase) {
+  return {
+    async listCollections(actor: SearchActor, input: unknown) {
+      const owner = actorId(actor),
+        query = contract.parseReferenceInput(contract.ReferencePageInputSchema, input),
+        page = pagination(owner, "COLLECTIONS", null, query);
+      return runSearchRead(database, async (tx) => {
+        const { readAt, payload } = await read(
+          tx,
+          sql.collectionsPageSql(owner, query.limit, page.after),
+        );
+        const rows = checked(
+          contract.CollectionReferenceSchema.array().max(query.limit + 1),
+          payload,
+        );
+        return finishReference(tx, contract.CollectionReferencePageSchema, {
+          version: 1,
+          readAt,
+          collections: rows.slice(0, query.limit),
+          nextCursor: page.next(rows),
+        });
+      });
+    },
+    async resolveCollections(actor: SearchActor, input: unknown) {
+      const owner = actorId(actor),
+        query = contract.parseReferenceInput(contract.CollectionReferencesInputSchema, input);
+      return runSearchRead(database, async (tx) => {
+        const { readAt, payload } = await read(tx, sql.collectionsResolveSql(owner, query.ids));
+        const rows = checked(contract.ReferenceCollectionRowsSchema, payload);
+        if (rows.length !== query.ids.length || rows.some((row, n) => row.id !== query.ids[n]))
+          searchFail("SEARCH_INVARIANT");
+        return finishReference(tx, contract.CollectionReferencesSchema, {
+          version: 1,
+          readAt,
+          references: rows.map((row) => {
+            const collection =
+              row.collection === null
+                ? null
+                : checked(contract.CollectionReferenceSchema, row.collection);
+            if (collection && collection.id !== row.id) searchFail("SEARCH_INVARIANT");
+            return { ...row, collection, state: collection === null ? "UNAVAILABLE" : "AVAILABLE" };
+          }),
+        });
+      });
+    },
+    async listCustomFields(actor: SearchActor, input: unknown) {
+      const owner = actorId(actor),
+        query = contract.parseReferenceInput(contract.CustomReferencePageInputSchema, input),
+        page = pagination(owner, "CUSTOM_FIELDS", query.collectionId, query);
+      return runSearchRead(database, async (tx) => {
+        const { readAt, payload } = await read(
+          tx,
+          sql.customPageSql(owner, query.collectionId, query.limit, page.after),
+        );
+        const raw = checked(contract.ReferenceCustomPageRowSchema, payload);
+        if (raw.collection === null) searchFail("FILTER_REFERENCE_INVALID");
+        if (checked(contract.CollectionReferenceSchema, raw.collection).id !== query.collectionId)
+          searchFail("SEARCH_INVARIANT");
+        const rows = checked(
+          contract.CustomReferenceSchema.array().max(query.limit + 1),
+          raw.definitions,
+        );
+        if (rows.some((row) => row.collectionId !== query.collectionId))
+          searchFail("SEARCH_INVARIANT");
+        return finishReference(tx, contract.CustomReferencePageSchema, {
+          version: 1,
+          readAt,
+          collection: raw.collection,
+          definitions: rows.slice(0, query.limit),
+          nextCursor: page.next(rows),
+        });
+      });
+    },
+    async resolveCustomFields(actor: SearchActor, input: unknown) {
+      const owner = actorId(actor),
+        query = contract.parseReferenceInput(contract.CustomReferencesInputSchema, input);
+      return runSearchRead(database, async (tx) => {
+        const { readAt, payload } = await read(tx, sql.customResolveSql(owner, query.references));
+        const rows = checked(contract.ReferenceCustomRowsSchema, payload);
+        if (
+          rows.length !== query.references.length ||
+          rows.some(
+            (row, n) => JSON.stringify(row.reference) !== JSON.stringify(query.references[n]),
+          )
+        )
+          searchFail("SEARCH_INVARIANT");
+        const entries = rows.map((row) => ({
+          ...row,
+          definition:
+            row.definition === null
+              ? null
+              : checked(contract.CustomReferenceSchema, row.definition),
+        }));
+        if (
+          entries.some(
+            (row) =>
+              row.definition &&
+              (row.definition.id !== row.reference[1] ||
+                row.definition.collectionId !== row.reference[0]),
+          )
+        )
+          searchFail("SEARCH_INVARIANT");
+        if (query.detail === "OPTIONS") {
+          const options = checked(
+            contract.ReferenceCustomOptionRowsSchema,
+            await tx.$queryRaw(sql.customOptionsSql(owner, query.references)),
+          );
+          if (options.length !== entries.length) searchFail("SEARCH_INVARIANT");
+          return finishReference(tx, contract.CustomReferencesSchema, {
+            version: 1,
+            readAt,
+            detail: query.detail,
+            references: entries.map((row, n) => {
+              const value = options[n]!;
+              if (value.ordinal !== n || value.id !== (row.definition?.id ?? null))
+                searchFail("SEARCH_INVARIANT");
+              cap(value.options, 100);
+              if (!row.definition && value.options.length) searchFail("SEARCH_INVARIANT");
+              return {
+                ...row,
+                state: row.definition ? "AVAILABLE" : "UNAVAILABLE",
+                definition: row.definition ? { ...row.definition, options: value.options } : null,
+              };
+            }),
+          });
+        }
+        return finishReference(tx, contract.CustomReferencesSchema, {
+          version: 1,
+          readAt,
+          detail: query.detail,
+          references: entries.map((row) => ({
+            ...row,
+            state: row.definition ? "AVAILABLE" : "UNAVAILABLE",
+          })),
+        });
+      });
+    },
+    async listConditions(actor: SearchActor, input: unknown) {
+      const owner = actorId(actor),
+        query = contract.parseReferenceInput(contract.ConditionReferencePageInputSchema, input),
+        page = pagination(owner, "CONDITIONS", query.categoryId, query);
+      return runSearchRead(database, async (tx) => {
+        const { readAt, payload } = await read(tx, sql.conditionsPageSql(query.categoryId));
+        const raw = checked(contract.ReferenceConditionPageRowSchema, payload);
+        if (raw.category === null) searchFail("FILTER_REFERENCE_INVALID");
+        if (checked(CategorySummarySchema, raw.category).id !== query.categoryId)
+          searchFail("SEARCH_INVARIANT");
+        cap(raw.options, 100);
+        const all = checked(contract.ConditionReferenceOptionSchema.array(), raw.options);
+        const scheme =
+          raw.scheme === null ? null : checked(contract.ConditionSchemeSummarySchema, raw.scheme);
+        if (
+          (scheme && scheme.categoryTemplateId !== query.categoryId) ||
+          all.some((o) => o.categoryTemplateId !== query.categoryId || o.schemeId !== scheme?.id)
+        )
+          searchFail("SEARCH_INVARIANT");
+        const rows = all.filter((row) => !page.after || row.id > page.after);
+        return finishReference(tx, contract.ConditionReferencePageSchema, {
+          version: 1,
+          readAt,
+          category: raw.category,
+          scheme,
+          options: rows.slice(0, query.limit),
+          nextCursor: page.next(rows),
+        });
+      });
+    },
+    async resolveConditions(actor: SearchActor, input: unknown) {
+      actorId(actor);
+      const query = contract.parseReferenceInput(contract.ConditionReferencesInputSchema, input);
+      return runSearchRead(database, async (tx) => {
+        const { readAt, payload } = await read(tx, sql.conditionsResolveSql(query.references));
+        const rows = checked(contract.ReferenceConditionRowsSchema, payload);
+        if (
+          rows.length !== query.references.length ||
+          rows.some(
+            (row, n) => JSON.stringify(row.reference) !== JSON.stringify(query.references[n]),
+          )
+        )
+          searchFail("SEARCH_INVARIANT");
+        return finishReference(tx, contract.ConditionReferencesSchema, {
+          version: 1,
+          readAt,
+          references: rows.map((row) => {
+            if (row.category === null || (row.reference[1] !== null && row.option === null))
+              return {
+                reference: row.reference,
+                state: "UNAVAILABLE",
+                category: null,
+                scheme: null,
+                option: null,
+              };
+            if (checked(CategorySummarySchema, row.category).id !== row.reference[0])
+              searchFail("SEARCH_INVARIANT");
+            const scheme =
+                row.scheme === null
+                  ? null
+                  : checked(contract.ConditionSchemeSummarySchema, row.scheme),
+              option =
+                row.option === null
+                  ? null
+                  : checked(contract.ConditionReferenceOptionSchema, row.option);
+            if (
+              (scheme && scheme.categoryTemplateId !== row.reference[0]) ||
+              (option &&
+                (option.id !== row.reference[1] ||
+                  option.categoryTemplateId !== row.reference[0] ||
+                  option.schemeId !== scheme?.id))
+            )
+              searchFail("SEARCH_INVARIANT");
+            return { ...row, state: "AVAILABLE" };
+          }),
+        });
+      });
+    },
+    async getCatalogDefinitionChoices(actor: SearchActor, categoryId: string) {
+      actorId(actor);
+      const parent = contract.parseReferenceInput(contract.ReferenceIdSchema, categoryId);
+      return runSearchRead(database, async (tx) => {
+        const { readAt, payload } = await read(tx, sql.catalogChoicesSql(parent));
+        const raw = checked(contract.ReferenceCatalogChoicesRowSchema, payload);
+        if (raw.category === null) searchFail("FILTER_REFERENCE_INVALID");
+        cap(raw.definitions, 100);
+        const result = finishReference(tx, contract.CatalogDefinitionChoicesSchema, {
+          version: 1,
+          readAt,
+          ...raw,
+        });
+        if (
+          result.category.id !== parent ||
+          result.definitions.some((d) => d.categoryTemplateId !== parent)
+        )
+          searchFail("SEARCH_INVARIANT");
+        return result;
+      });
+    },
+    async getCatalogDefinition(actor: SearchActor, categoryId: string, definitionId: string) {
+      actorId(actor);
+      const parent = contract.parseReferenceInput(contract.ReferenceIdSchema, categoryId),
+        id = contract.parseReferenceInput(contract.ReferenceIdSchema, definitionId);
+      return runSearchRead(database, async (tx) => {
+        const { readAt, payload } = await read(tx, sql.catalogDefinitionSql(parent, id));
+        const raw = checked(contract.ReferenceCatalogDefinitionRowSchema, payload);
+        if (raw.category === null || raw.definition === null)
+          searchFail("FILTER_REFERENCE_INVALID");
+        const data = checked(contract.ReferenceOptionsRowSchema, raw.definition);
+        cap(data.options, 100);
+        const result = finishReference(tx, contract.CatalogDefinitionReferenceSchema, {
+          version: 1,
+          readAt,
+          ...raw,
+        });
+        if (
+          result.category.id !== parent ||
+          result.definition.id !== id ||
+          result.definition.categoryTemplateId !== parent
+        )
+          searchFail("SEARCH_INVARIANT");
+        return result;
+      });
+    },
+  };
+}
diff --git a/packages/domain/src/search/search-reference-sql.ts b/packages/domain/src/search/search-reference-sql.ts
new file mode 100644
index 0000000..b786150
--- /dev/null
+++ b/packages/domain/src/search/search-reference-sql.ts
@@ -0,0 +1,56 @@
+import { Prisma } from "@sammlerraum/db/search-sql";
+// All identifiers below are static implementation constants, never request input.
+const clock = Prisma.sql`date_trunc('milliseconds',transaction_timestamp()) AS "readAt"`;
+function text(column: string, maxBytes: number) {
+  return Prisma.sql`CASE WHEN octet_length(${Prisma.raw(column)}) <= ${maxBytes} THEN ${Prisma.raw(column)} ELSE NULL END`;
+}
+const collection = Prisma.sql`CASE WHEN c.id IS NULL THEN NULL ELSE jsonb_build_object('id',c.id,'name',${text("c.name", 480)}) END`;
+const custom = Prisma.sql`CASE WHEN d.id IS NULL THEN NULL ELSE jsonb_build_object('id',d.id,'collectionId',d."collectionId",'name',${text("d.name", 480)},'type',d.type) END`;
+function labels(
+  table: "CategoryTemplateLabel" | "CatalogAttributeLabel" | "CatalogAttributeOptionLabel",
+  column: "categoryTemplateId" | "definitionId" | "optionId",
+  alias: "c" | "d" | "o",
+) {
+  const label = (locale: string) =>
+    Prisma.sql`(SELECT ${text("l.label", 800)} FROM ${Prisma.raw(`"${table}"`)} l WHERE l.${Prisma.raw(`"${column}"`)}=${Prisma.raw(alias)}.id AND l.locale=${locale})`;
+  return Prisma.sql`jsonb_build_object('de',${label("de")},'en',${label("en")})`;
+}
+const category = Prisma.sql`CASE WHEN c.id IS NULL THEN NULL ELSE jsonb_build_object('id',c.id,'key',c.key,'labels',${labels("CategoryTemplateLabel", "categoryTemplateId", "c")}) END`;
+const scheme = Prisma.sql`CASE WHEN s.id IS NULL THEN NULL ELSE jsonb_build_object('id',s.id,'categoryTemplateId',s."categoryTemplateId",'key',s.key,'labels',jsonb_build_object('de',${text('s."labelDe"', 800)},'en',${text('s."labelEn"', 800)}),'active',s.active) END`;
+const condition = Prisma.sql`CASE WHEN o.id IS NULL THEN NULL ELSE jsonb_build_object('id',o.id,'schemeId',o."schemeId",'categoryTemplateId',o."categoryTemplateId",'labelKey',o."labelKey",'labels',jsonb_build_object('de',${text('o."labelDe"', 800)},'en',${text('o."labelEn"', 800)}),'active',o.active,'position',o.position,'normalizedBand',o."normalizedBand") END`;
+const definition = Prisma.sql`jsonb_build_object('id',d.id,'categoryTemplateId',d."categoryTemplateId",'key',d.key,'type',d.type,'position',d.position,'labels',${labels("CatalogAttributeLabel", "definitionId", "d")})`;
+const catalogOption = Prisma.sql`jsonb_build_object('id',o.id,'key',o.key,'position',o.position,'labels',${labels("CatalogAttributeOptionLabel", "optionId", "o")})`;
+function pairs(references: readonly (readonly [string, string | null])[]) {
+  return Prisma.join(
+    references.map(
+      ([parent, id], ordinal) => Prisma.sql`(${ordinal}::integer,${parent}::uuid,${id}::uuid)`,
+    ),
+  );
+}
+export function collectionsPageSql(actor: string, limit: number, after: string | null) {
+  return Prisma.sql`SELECT ${clock}, COALESCE((SELECT jsonb_agg(value ORDER BY id) FROM (SELECT c.id,${collection} AS value FROM "Collection" c WHERE c."ownerId"=${actor} AND c."deletedAt" IS NULL AND (${after}::uuid IS NULL OR c.id>${after}::uuid) ORDER BY c.id LIMIT ${limit + 1}) page),'[]'::jsonb) AS payload`;
+}
+export function collectionsResolveSql(actor: string, ids: string[]) {
+  return Prisma.sql`SELECT ${clock},(SELECT jsonb_agg(jsonb_build_object('id',i.id,'collection',${collection}) ORDER BY i.ordinal) FROM (VALUES ${Prisma.join(ids.map((id, n) => Prisma.sql`(${n}::integer,${id}::uuid)`))}) i(ordinal,id) LEFT JOIN "Collection" c ON c.id=i.id AND c."ownerId"=${actor} AND c."deletedAt" IS NULL) AS payload`;
+}
+export function customPageSql(actor: string, parent: string, limit: number, after: string | null) {
+  return Prisma.sql`SELECT ${clock},jsonb_build_object('collection',${collection},'definitions',COALESCE((SELECT jsonb_agg(value ORDER BY id) FROM (SELECT d.id,${custom} AS value FROM "CustomFieldDefinition" d WHERE d."collectionId"=c.id AND (${after}::uuid IS NULL OR d.id>${after}::uuid) ORDER BY d.id LIMIT ${limit + 1}) page),'[]'::jsonb)) AS payload FROM (VALUES(1)) marker LEFT JOIN "Collection" c ON c.id=${parent}::uuid AND c."ownerId"=${actor} AND c."deletedAt" IS NULL`;
+}
+export function customResolveSql(actor: string, references: [string, string][]) {
+  return Prisma.sql`SELECT ${clock},(SELECT jsonb_agg(jsonb_build_object('reference',jsonb_build_array(i.parent,i.id),'definition',${custom}) ORDER BY i.ordinal) FROM (VALUES ${pairs(references)}) i(ordinal,parent,id) LEFT JOIN "Collection" c ON c.id=i.parent AND c."ownerId"=${actor} AND c."deletedAt" IS NULL LEFT JOIN "CustomFieldDefinition" d ON d.id=i.id AND d."collectionId"=c.id) AS payload`;
+}
+export function customOptionsSql(actor: string, references: [string, string][]) {
+  return Prisma.sql`SELECT i.ordinal,d.id,COALESCE((SELECT jsonb_agg(value ORDER BY position,id) FROM (SELECT o.id,o.position,CASE WHEN o.position BETWEEN 0 AND 99 THEN ${text("o.value", 800)} ELSE NULL END AS value FROM "CustomFieldOption" o WHERE o."fieldDefinitionId"=d.id ORDER BY o.position,o.id LIMIT 101) options),'[]'::jsonb) AS options FROM (VALUES ${pairs(references)}) i(ordinal,parent,id) LEFT JOIN "Collection" c ON c.id=i.parent AND c."ownerId"=${actor} AND c."deletedAt" IS NULL LEFT JOIN "CustomFieldDefinition" d ON d.id=i.id AND d."collectionId"=c.id ORDER BY i.ordinal`;
+}
+export function conditionsPageSql(parent: string) {
+  return Prisma.sql`SELECT ${clock},jsonb_build_object('category',${category},'scheme',${scheme},'options',COALESCE((SELECT jsonb_agg(value ORDER BY id) FROM (SELECT o.id,${condition} AS value FROM "ConditionOption" o WHERE o."schemeId"=s.id AND o."categoryTemplateId"=c.id ORDER BY o.id LIMIT 101) options),'[]'::jsonb)) AS payload FROM (VALUES(1)) marker LEFT JOIN "CategoryTemplate" c ON c.id=${parent}::uuid LEFT JOIN "ConditionScheme" s ON s."categoryTemplateId"=c.id`;
+}
+export function conditionsResolveSql(references: [string, string | null][]) {
+  return Prisma.sql`SELECT ${clock},(SELECT jsonb_agg(jsonb_build_object('reference',jsonb_build_array(i.parent,i.id),'category',${category},'scheme',${scheme},'option',${condition}) ORDER BY i.ordinal) FROM (VALUES ${pairs(references)}) i(ordinal,parent,id) LEFT JOIN "CategoryTemplate" c ON c.id=i.parent LEFT JOIN "ConditionScheme" s ON s."categoryTemplateId"=c.id LEFT JOIN "ConditionOption" o ON o.id=i.id AND o."schemeId"=s.id AND o."categoryTemplateId"=c.id) AS payload`;
+}
+export function catalogChoicesSql(parent: string) {
+  return Prisma.sql`SELECT ${clock},jsonb_build_object('category',${category},'definitions',COALESCE((SELECT jsonb_agg(value ORDER BY position,id) FROM (SELECT d.id,d.position,${definition} AS value FROM "CatalogAttributeDefinition" d WHERE d."categoryTemplateId"=c.id ORDER BY d.position,d.id LIMIT 101) definitions),'[]'::jsonb)) AS payload FROM (VALUES(1)) marker LEFT JOIN "CategoryTemplate" c ON c.id=${parent}::uuid`;
+}
+export function catalogDefinitionSql(parent: string, id: string) {
+  return Prisma.sql`SELECT ${clock},jsonb_build_object('category',${category},'definition',CASE WHEN d.id IS NULL THEN NULL ELSE ${definition} || jsonb_build_object('options',COALESCE((SELECT jsonb_agg(value ORDER BY position,id) FROM (SELECT o.id,o.position,${catalogOption} AS value FROM "CatalogAttributeOption" o WHERE o."definitionId"=d.id ORDER BY o.position,o.id LIMIT 101) options),'[]'::jsonb)) END) AS payload FROM (VALUES(1)) marker LEFT JOIN "CategoryTemplate" c ON c.id=${parent}::uuid LEFT JOIN "CatalogAttributeDefinition" d ON d.id=${id}::uuid AND d."categoryTemplateId"=c.id`;
+}
