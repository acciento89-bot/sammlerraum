+      <header className="management-heading management-heading-row">
+        <div>
+          <p className="eyebrow">{t("eyebrow")}</p>
+          <h1>{data.collection.name}</h1>
+        </div>
+        <Link className="primary-link" href={`/${locale}/items/new?collectionId=${collectionId}`}>
+          {t("addItem")}
