+            </label>
+            {(fieldType === "SINGLE_SELECT" || fieldType === "MULTI_SELECT") && (
+              <label>
+                {t("fieldOptions")}
+                <textarea name="options" required />
+                <span className="field-help">{t("fieldOptionsHelp")}</span>
+              </label>
