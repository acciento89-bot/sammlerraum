+
+    CONSTRAINT "CustomFieldValue_pkey" PRIMARY KEY ("itemId","fieldDefinitionId")
+);
+
+-- CreateTable
+CREATE TABLE "CustomFieldMultiSelectValue" (
+    "itemId" UUID NOT NULL,
+    "fieldDefinitionId" UUID NOT NULL,
