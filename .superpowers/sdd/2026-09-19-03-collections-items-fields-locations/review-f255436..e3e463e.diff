+      $queryRaw: vi.fn(async () => {
+        calls.push("lock-item");
+        return [{ id: itemId, ownerId, storageLocationId: null }];
+      }),
+      storageLocation: {
+        findUnique: vi.fn(async () => {
+          calls.push("find-location");
+          return { id: locationId, ownerId };
+        }),
