+        updateMany: vi.fn(async () => {
+          calls.push("update-item");
+          return { count: 1 };
+        }),
+      },
+      itemLocationHistory: {
+        create: vi.fn(async ({ data }: { data: Record<string, unknown> }) => {
+          calls.push("create-history");
+          return { id: childId, movedAt: new Date("2026-09-20T12:00:00.000Z"), ...data };
