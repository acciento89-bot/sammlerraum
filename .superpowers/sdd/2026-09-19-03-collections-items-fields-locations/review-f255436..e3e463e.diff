+      items: [{ id: itemId, title: "Penny Black" }],
+    });
+  });
+});
+
+describe("public item query", () => {
+  it("keeps protected item and storage data out of the public item DTO", async () => {
+    const database = {
+      $queryRaw: vi.fn().mockResolvedValue([
