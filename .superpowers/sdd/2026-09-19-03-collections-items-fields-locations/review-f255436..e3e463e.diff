+      ).rejects.toMatchObject({ code: "LOCATION_NOT_FOUND" });
+      await expect(
+        prisma!.storageLocation.update({ where: { id: a.id }, data: { parentId: foreign.id } }),
+      ).rejects.toBeDefined();
+
+      const results = await Promise.allSettled([
+        service.moveLocation(a.id, b.id),
