{
  "name": "sammlerraum",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --check .",
    "dev:web": "pnpm --filter @sammlerraum/web dev",
    "dev:worker": "pnpm --filter @sammlerraum/worker dev",
    "lighthouse:ci": "lhci autorun"
  },
  "devDependencies": {
    "@lhci/cli": "0.16.0",
    "@types/node": "24.5.2",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  }
}
