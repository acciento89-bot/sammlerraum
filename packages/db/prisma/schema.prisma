  @@unique([ownerId, uploadRequestId])
  @@index([sourceExpiresAt, id])
  @@index([ownerId, createdAt(sort: Desc), id])
  @@index([status, updatedAt, id])
}

model ImportRow {
  id                        String          @id @default(uuid()) @db.Uuid
