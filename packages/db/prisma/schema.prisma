generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model SystemMetadata {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model UserProfile {
  userId        String   @id
  handle        String   @unique
  displayName   String
  bio           String?
  avatarAssetId String?  @db.Uuid
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
