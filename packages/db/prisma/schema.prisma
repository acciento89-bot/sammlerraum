  @@index([status, processingLeaseUntil, id])
  @@index([status, lastDispatchedAt, id])
}

model ImportSourceObject {
  id               String     @id @db.Uuid
  jobId            String?    @unique @db.Uuid
  storageKey       String     @unique
  expiresAt        DateTime
  createdAt        DateTime   @default(dbgenerated("timezone('UTC'::text, CURRENT_TIMESTAMP)"))
  cleanupStartedAt DateTime?
  deletedAt        DateTime?
  lastAttemptAt    DateTime?
  lastReconciledAt DateTime?
  job              ImportJob? @relation(fields: [jobId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([lastAttemptAt, expiresAt, id])
}

enum CollectionMemberRole {
  ADMIN
  EDITOR
  VIEWER
}

// OWNER is derived solely from Collection.ownerId, never a second membership row.
model CollectionMember {
  collectionId String               @db.Uuid
  userId       String
  role         CollectionMemberRole
  createdAt    DateTime             @default(dbgenerated("timezone('UTC'::text, CURRENT_TIMESTAMP)")) @db.Timestamp(3)
  updatedAt    DateTime             @default(dbgenerated("timezone('UTC'::text, CURRENT_TIMESTAMP)")) @db.Timestamp(3)
  collection   Collection           @relation(fields: [collectionId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([collectionId, userId])
  @@index([userId, collectionId])
}

// Transaction-bound ownership transition receipt; never contains item values or file bytes.
model CollectionOwnershipTransfer {
  id            String     @id @db.Uuid
  collectionId  String     @db.Uuid
  fromOwnerId   String?
  toOwnerId     String?
  actorId       String?
  fromRevision  Int
  toRevision    Int
  transactionId String     @db.VarChar(20)
  createdAt     DateTime   @default(dbgenerated("timezone('UTC'::text, CURRENT_TIMESTAMP)")) @db.Timestamp(3)
  collection    Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  fromOwner     User?      @relation("CollectionTransferFrom", fields: [fromOwnerId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  toOwner       User?      @relation("CollectionTransferTo", fields: [toOwnerId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  actor         User?      @relation("CollectionTransferActor", fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@unique([collectionId, toRevision])
  @@unique([collectionId, transactionId])
  @@index([fromOwnerId])
  @@index([toOwnerId])
  @@index([actorId])
}

enum CollectionInvitationTargetKind {
  EMAIL
  USER
}

model CollectionInvitation {
  id               String                         @id @default(uuid()) @db.Uuid
  collectionId     String                         @db.Uuid
  creatorUserId    String
  targetKind       CollectionInvitationTargetKind
  targetEmail      String?                        @db.VarChar(254)
  targetUserId     String?
  role             CollectionMemberRole
  tokenHash        String                         @unique @db.Char(64)
  createdAt        DateTime                       @default(dbgenerated("timezone('UTC'::text, CURRENT_TIMESTAMP)"))
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  revokedAt        DateTime?
  collection       Collection                     @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  creator          User                           @relation("CollectionInvitationCreator", fields: [creatorUserId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  target           User?                          @relation("CollectionInvitationTarget", fields: [targetUserId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  acceptor         User?                          @relation("CollectionInvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([collectionId, expiresAt, id])
  @@index([creatorUserId])
  @@index([targetUserId])
  @@index([targetEmail])
  @@index([acceptedByUserId])
}

model CollectionShare {
  trashRevocation ShareRevocation?
  pinBudget       SharePinBudget?
  accessSessions  ShareAccessSession[]
  id              String               @id @default(uuid()) @db.Uuid
  collectionId    String               @db.Uuid
  creatorUserId   String
  targetKind      String               @db.VarChar(10)
  targetId        String               @db.Uuid
  recipientUserId String?
  tokenHash       String?              @unique @db.Char(64)
  permissions     Json
  pinHash         String?
  revision        Int                  @default(0)
  createdAt       DateTime             @default(dbgenerated("timezone('UTC'::text, CURRENT_TIMESTAMP)"))
  expiresAt       DateTime?
  revokedAt       DateTime?
  collection      Collection           @relation(fields: [collectionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  creator         User                 @relation("ShareCreator", fields: [creatorUserId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  recipient       User?                @relation("ShareRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([collectionId, id])
  @@index([creatorUserId])
  @@index([recipientUserId])
}

model SharePinBudget {
  shareId         String          @id @db.Uuid
  attempts        Int
  windowStartedAt DateTime
  share           CollectionShare @relation(fields: [shareId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model ShareAccessSession {
  tokenHash String          @id @db.Char(64)
  shareId   String          @db.Uuid
  expiresAt DateTime
  share     CollectionShare @relation(fields: [shareId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([shareId, expiresAt])
}

enum AuditSource {
  USER
  IMPORT
  AI
  MARKET_SYNC
  SYSTEM
  MODERATION
}

enum AuditResourceType {
  COLLECTION
  NODE
  ITEM
  LOCATION
  IMPORT_JOB
  SHARE
}

model AuditEvent {
  id                  String            @id @default(uuid()) @db.Uuid
  sequence            BigInt            @unique @default(autoincrement())
  resourceType        AuditResourceType
  resourceId          String            @db.Uuid
  collectionId        String?           @db.Uuid
  itemId              String?           @db.Uuid
  locationOwnerUserId String?
  action              String            @db.VarChar(80)
  source              AuditSource
  actorId             String?
  subjectUserId       String?
  before              Json
  after               Json
  createdAt           DateTime          @default(dbgenerated("timezone('UTC'::text, clock_timestamp())"))
  collection          Collection?       @relation(fields: [collectionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  item                CollectibleItem?  @relation(fields: [itemId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  locationOwner       User?             @relation("AuditLocationOwner", fields: [locationOwnerUserId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  actor               User?             @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  subject             User?             @relation("AuditSubject", fields: [subjectUserId], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@index([resourceType, resourceId, sequence(sort: Desc)])
  @@index([collectionId])
  @@index([itemId])
  @@index([locationOwnerUserId])
  @@index([actorId])
  @@index([subjectUserId])
}

model ShareRevocation {
  shareId   String          @id @db.Uuid
  revokedAt DateTime        @default(dbgenerated("timezone('UTC'::text, clock_timestamp())")) @db.Timestamp(3)
  reason    String          @db.VarChar(32)
  share     CollectionShare @relation(fields: [shareId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model WishlistEntry {
  id                      String          @id @default(uuid()) @db.Uuid
  ownerId                 String
  title                   String
  catalogEntryId          String?         @db.Uuid
  catalogVariantId        String?         @db.Uuid
  desiredCondition        String?
  targetAmountMinor       BigInt?
  targetCurrency          String?         @db.Char(3)
  targetMinorUnitExponent Int?
  targetUnitKey           String?         @db.VarChar(40)
  priority                Int             @default(3)
  notes                   String?
  fulfilledAt             DateTime?
  createdAt               DateTime        @default(now())
  owner                   User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  catalogEntry            CatalogEntry?   @relation(fields: [catalogEntryId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  // SQL narrows SET NULL to variantId so the desired entry remains intact.
  catalogVariant          CatalogVariant? @relation(fields: [catalogVariantId, catalogEntryId], references: [id, entryId], onDelete: SetNull, onUpdate: Restrict)

  @@index([ownerId, id])
  @@index([ownerId, fulfilledAt, id])
  @@index([catalogEntryId])
  @@index([catalogVariantId, catalogEntryId])
}

model DuplicateRelation {
  id        String          @id @default(uuid()) @db.Uuid
  ownerId   String
  itemAId   String          @db.Uuid
  itemBId   String          @db.Uuid
  createdAt DateTime        @default(now())
  owner     User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  itemA     CollectibleItem @relation("DuplicateA", fields: [itemAId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  itemB     CollectibleItem @relation("DuplicateB", fields: [itemBId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([ownerId, itemAId, itemBId])
  @@index([itemAId])
  @@index([itemBId])
}

model UserFollow {
  id         String   @id @default(uuid()) @db.Uuid
  followerId String
  followedId String
  createdAt  DateTime @default(now())
  follower   User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  followed   User     @relation("Followers", fields: [followedId], references: [id], onDelete: Cascade)

  @@unique([followerId, followedId])
  @@index([followerId, id])
  @@index([followedId, id])
}

// Persistence/policy seam required by Task2; actual block/report workflow follows in Task3.
model UserBlock {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId, blockerId])
}

enum FavoriteTargetType {
  COLLECTION
  ITEM
}

model Favorite {
  id           String             @id @default(uuid()) @db.Uuid
  userId       String
  type         FavoriteTargetType
  collectionId String?            @db.Uuid
  itemId       String?            @db.Uuid
  createdAt    DateTime           @default(now())
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  collection   Collection?        @relation(fields: [collectionId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  item         CollectibleItem?   @relation(fields: [itemId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([userId, collectionId])
  @@unique([userId, itemId])
  @@index([userId, id])
  @@index([collectionId])
  @@index([itemId])
}

model CommunityPreference {
  userId          String  @id
  commentsEnabled Boolean @default(true)
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CommunityComment {
  moderationEvents   CommunityModerationEvent[]
  id                 String                     @id @default(uuid()) @db.Uuid
  authorId           String
  collectionId       String                     @db.Uuid
  itemId             String?                    @db.Uuid
  parentId           String?                    @db.Uuid
  body               String
  ownerHiddenAt      DateTime?
  moderationHiddenAt DateTime?
  deletedAt          DateTime?
  createdAt          DateTime                   @default(now())
  author             User                       @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  collection         Collection                 @relation(fields: [collectionId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  item               CollectibleItem?           @relation(fields: [itemId, collectionId], references: [id, collectionId], onDelete: Cascade, onUpdate: Restrict)
  parent             CommunityComment?          @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  replies            CommunityComment[]         @relation("CommentReplies")
  reports            CommunityReport[]

  @@index([collectionId, itemId, id])
  @@index([authorId, createdAt])
  @@index([itemId])
  @@index([parentId])
}

enum CommunityReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum CommunityReportTarget {
  USER
  COMMENT
}

model CommunityReport {
  moderationEvents CommunityModerationEvent[]
  id               String                     @id @default(uuid()) @db.Uuid
  reporterId       String?
  targetType       CommunityReportTarget
  targetSnapshotId String                     @db.VarChar(128)
  userId           String?
  commentId        String?                    @db.Uuid
  category         String                     @db.VarChar(32)
  reason           String
  status           CommunityReportStatus      @default(OPEN)
  createdAt        DateTime                   @default(now())
  resolvedAt       DateTime?
  resolvedById     String?
  resolutionReason String?
  reporter         User?                      @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  targetUser       User?                      @relation("ReportUserTarget", fields: [userId], references: [id], onDelete: SetNull)
  comment          CommunityComment?          @relation(fields: [commentId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  resolvedBy       User?                      @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt, id])
  @@index([reporterId, targetType, targetSnapshotId])
  @@index([commentId])
  @@index([userId])
  @@index([resolvedById])
}

// Platform-only append history; never part of content-owner audit reads.
model CommunityModerationEvent {
  id               String            @id @default(uuid()) @db.Uuid
  actorId          String?
  reportId         String?           @db.Uuid
  commentId        String?           @db.Uuid
  targetSnapshotId String            @db.VarChar(128)
  source           AuditSource       @default(MODERATION)
  action           String            @db.VarChar(40)
  reason           String
  before           Json
  after            Json
  createdAt        DateTime          @default(now())
  actor            User?             @relation(fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  report           CommunityReport?  @relation(fields: [reportId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  comment          CommunityComment? @relation(fields: [commentId], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@index([reportId, createdAt])
  @@index([commentId, createdAt])
  @@index([actorId])
}

model Notification {
  emailDelivery NotificationEmailDelivery?
  id            String                     @id @default(uuid()) @db.Uuid
  recipientId   String
  actorId       String?
  eventKey      String                     @db.VarChar(200)
  type          String                     @db.VarChar(40)
  category      String                     @db.VarChar(24)
  targetType    String                     @db.VarChar(24)
  targetId      String                     @db.VarChar(128)
  locale        String                     @default("de") @db.VarChar(2)
  inAppEnabled  Boolean                    @default(true)
  emailWanted   Boolean                    @default(false)
  readAt        DateTime?
  createdAt     DateTime                   @default(now())
  recipient     User                       @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  actor         User?                      @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@unique([recipientId, eventKey])
  @@index([recipientId, inAppEnabled, createdAt(sort: Desc), id(sort: Desc)])
  @@index([actorId])
}

model NotificationPreference {
  userId   String
  category String  @db.VarChar(24)
  channel  String  @db.VarChar(16)
  enabled  Boolean
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([userId, category, channel])
}

model NotificationSettings {
  userId String @id
  locale String @default("de") @db.VarChar(2)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
}

model NotificationEmailDelivery {
  id                String       @id @default(uuid()) @db.Uuid
  notificationId    String       @unique @db.Uuid
  status            String       @default("PENDING") @db.VarChar(16)
  attempts          Int          @default(0)
  leaseToken        String?      @db.Uuid
  leaseUntil        DateTime?
  nextAttemptAt     DateTime     @default(now())
  providerMessageId String?      @db.VarChar(512)
  lastOutcome       String?      @db.VarChar(32)
  sentAt            DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @default(now())
  notification      Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([status, nextAttemptAt, id])
  @@index([status, leaseUntil])
}

enum AIAnalysisStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  CANCELLED
}

enum AIAnalysisAttemptStatus {
  PENDING
  SUCCEEDED
  FAILED
  DISCARDED
  ABANDONED
}

model AIAnalysisJob {
  id               String                @id @default(uuid()) @db.Uuid
  requesterId      String
  itemId           String                @db.Uuid
  collectionId     String                @db.Uuid
  requestKey       String                @db.Uuid
  requestDigest    String                @db.Char(64)
  sources          Json
  providerId       String                @db.VarChar(64)
  model            String                @db.VarChar(128)
  status           AIAnalysisStatus      @default(PENDING)
  attempts         Int                   @default(0)
  leaseToken       String?               @db.Uuid
  leaseUntil       DateTime?
  nextAttemptAt    DateTime              @default(now())
  errorCode        String?               @db.VarChar(64)
  lastDispatchedAt DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  requester        User                  @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  item             CollectibleItem       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  collection       Collection            @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  suggestion       AIAnalysisSuggestion?
  attemptRecords   AIAnalysisAttempt[]

  @@unique([requesterId, requestKey])
  @@index([requesterId, createdAt])
  @@index([itemId, requesterId, createdAt])
  @@index([status, nextAttemptAt, lastDispatchedAt, id])
  @@index([status, leaseUntil])
}

model AIAnalysisSuggestion {
  jobId           String        @id @db.Uuid
  completionToken String        @db.Uuid
  payload         Json
  payloadSha256   String        @db.Char(64)
  createdAt       DateTime      @default(now())
  job             AIAnalysisJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model AIAnalysisAttempt {
  jobId        String                  @db.Uuid
  number       Int
  token        String                  @unique @db.Uuid
  outcome      AIAnalysisAttemptStatus @default(PENDING)
  inputTokens  Int?
  outputTokens Int?
  errorCode    String?                 @db.VarChar(64)
  startedAt    DateTime                @default(now())
  finishedAt   DateTime?
  job          AIAnalysisJob           @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([jobId, number])
}
