  sourceFileName         String              @db.VarChar(255)
  sourceByteSize         BigInt
  sourceChecksumSha256   String              @db.Char(64)
  sourceStorageKey       String              @unique
  sourceVerifiedAt       DateTime?
  uploadRequestId        String?             @db.Uuid
  uploadOptions          Json?
  uploadCompletedAt      DateTime?
  sourceExpiresAt        DateTime            @default(dbgenerated("(timezone('UTC'::text, CURRENT_TIMESTAMP) + '24:00:00'::interval)"))
  lastDispatchedAt       DateTime?
  parserOptions          Json?
  parsedHeader           Json?
  parsingToken           String?             @db.Uuid
  parsingLeaseUntil      DateTime?
  parsingAttempts        Int                 @default(0)
  totalRows              Int?
  parsedRows             Int                 @default(0)
  previewedRows          Int                 @default(0)
  committedRows          Int                 @default(0)
  commitApprovedAt       DateTime?
  commitApprovalRevision Int?
  previewGeneration      Int                 @default(0)
