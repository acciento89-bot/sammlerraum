enum ImportSourceFormat {
  CSV
  XLSX
}

enum ImportJobStatus {
  AWAITING_UPLOAD
  PARSING
  PARSED
  PREVIEWING
  REVIEW_READY
  COMMITTING
  COMPLETED
  FAILED
  CANCELLED
}

enum ImportRowStatus {
  PENDING
  READY
  CONFLICT
  INVALID
  COMMITTED
  SKIPPED
}

model ImportJob {
  id                     String              @id @default(uuid()) @db.Uuid
  ownerId                String
  collectionId           String              @db.Uuid
  locale                 String              @db.VarChar(2)
  status                 ImportJobStatus     @default(AWAITING_UPLOAD)
  revision               Int                 @default(1)
